#!/usr/bin/env bashio
# ==============================================================================
# Take down the whole add-on when the server exits unexpectedly so the
# Supervisor watchdog and the user can see it, instead of s6 silently
# restarting it forever.
# ==============================================================================
declare APP_EXIT_CODE=${1}

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
    bashio::log.warning "Claude for Home Assistant exited with code ${APP_EXIT_CODE}"
    echo "${APP_EXIT_CODE}" > /run/s6-linux-init-container-results/exitcode
    exec /run/s6/basedir/bin/halt
fi

bashio::log.info "Service restart after closing"
